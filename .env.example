# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Database (Neon). DATABASE_URL = pooled connection, DIRECT_URL = direct (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Public base URL of the app (used for OAuth / email redirects). Leave unset locally
# to fall back to the browser origin / http://localhost:3000.
NEXT_PUBLIC_APP_URL="https://email-application.<your-subdomain>.workers.dev"

# Supabase Auth (user sign-in). Google sign-in is configured in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Nylas (mailbox linking + all mail access). Google/Microsoft OAuth apps are configured
# as connectors in the Nylas dashboard, not here.
NYLAS_CLIENT_ID=""
NYLAS_API_KEY=""
NYLAS_API_URI="https://api.us.nylas.com"
# Optional: defaults to ${NEXT_PUBLIC_APP_URL}/api/nylas/callback. Must be registered in Nylas.
# NYLAS_CALLBACK_URI="http://localhost:3000/api/nylas/callback"
# Webhook secret from Nylas (webhook URL: /api/webhooks/nylas). Enables signature checks + live refresh.
NYLAS_WEBHOOK_SECRET=""

# OpenAI (AI copilot)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Svix webhooks
SVIX_TOKEN=""
SVIX_APP_ID=""
SVIX_WEBHOOK_SECRET=""
