{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "email-application",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-23",
  // nodejs_compat: pg (TCP via connect()), Buffer, crypto used by Prisma, Nylas webhooks and Supabase.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Non-secret runtime vars. Secrets go in with `npx wrangler secret put NAME`
  // (DATABASE_URL, NYLAS_API_KEY, NYLAS_CLIENT_ID, NYLAS_WEBHOOK_SECRET, OPENAI_API_KEY, SVIX_*).
  "vars": {
    "NYLAS_API_URI": "https://api.us.nylas.com"
  }
}
