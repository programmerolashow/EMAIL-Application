// Generated into node_modules/@prisma/client (regenerated by `postinstall`).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id
  firstname      String
  lastname       String
  time           DateTime       @default(now())
  email          String
  imageURL       String
  /// Subscription plan id (see src/server/services/plans.ts). Changed in the DB until payments exist.
  plan           String         @default("free")
  /// ISO 3166-1 alpha-2 country, chosen at sign-up (or in the dashboard prompt). Sets the billing currency.
  country        String?
  accounts       Account[]
  aiResults      AiResult[]
  usageEvents    UsageEvent[]
}

model Account {
  id                String    @id
  userId            String
  provider          String?
  providerAccountId String?
  email             String
  name              String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String   @unique
  eventType String
  accountId String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([provider, eventType])
  @@index([status])
}

/// Saved AI output (summary, intelligence, action items) per email / thread, so it is shown
/// again instead of being regenerated. `version` is the newest message id it was built from.
model AiResult {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  targetKey String
  version   String?
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, targetKey])
}

/// One row per counted use of a limited action (AI reruns, sends). Rows older than the limit
/// window are ignored and pruned.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, key, createdAt])
}
